# Reference values for the current intranet setup.
# Application and Nacos YAML files already contain these literal values.
# No environment variables or .env loading are required for application startup.

# All five applications. Use the initialized Nacos login credentials.
NACOS_SERVER_ADDR=192.168.20.5:8848
NACOS_USERNAME=nacos
NACOS_PASSWORD=ssyhsup
# Empty means public; otherwise use the namespace ID, not its display name.
NACOS_NAMESPACE=
NACOS_GROUP=DEFAULT_GROUP
SPRING_PROFILES_ACTIVE=dev

# Article and user services. Confirm the actual MySQL port exposed by the NAS.
MYSQL_HOST=192.168.20.5
MYSQL_PORT=3306
MYSQL_DATABASE=how-blog
MYSQL_USERNAME=root
MYSQL_PASSWORD=ssyhsup
JPA_SHOW_SQL=false

# Article and user services. An empty password is valid for unauthenticated Redis.
REDIS_HOST=192.168.20.5
REDIS_PORT=6379
REDIS_PASSWORD=ssyhsup
REDIS_DATABASE=0

# User and SMS services. Both services must use the same Kafka topic.
KAFKA_BOOTSTRAP_SERVERS=192.168.20.10:9092
KAFKA_SMS_TOPIC=sms
# SMS instances share this group so only one instance handles each message.
KAFKA_SMS_GROUP_ID=how-sms

# Search service uses the Elasticsearch HTTP API. The NAS has analysis-smartcn.
ELASTICSEARCH_URIS=http://192.168.20.5:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=ssyhsup

# Article, user and gateway services must share one secret.
# Generate 32 cryptographically random bytes, then encode them as Base64.
# This is separate from the Nacos server's NACOS_AUTH_TOKEN.
JWT_SECRET=P1AXH29zhYz/U7v0Ft4jWjUs3myjsVBfd6SnhzoTNO4=
JWT_TTL=360000

# Aliyun SMS values are currently unavailable; fill in how-sms-dev.yaml before sending SMS.
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
