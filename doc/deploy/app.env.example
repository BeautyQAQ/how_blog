# Reference for application process environment variables; Spring Boot does not
# automatically load this file or a plain .env file. Configure these in your IDE.
# Keep credentials local. Never commit a filled-in copy of this example.

# All five applications. Use the initialized Nacos login credentials.
NACOS_SERVER_ADDR=192.168.20.5:8848
NACOS_USERNAME=
NACOS_PASSWORD=
# Empty means public; otherwise use the namespace ID, not its display name.
NACOS_NAMESPACE=
NACOS_GROUP=DEFAULT_GROUP
SPRING_PROFILES_ACTIVE=dev

# Article and user services. Confirm the actual MySQL port exposed by the NAS.
MYSQL_HOST=192.168.20.5
MYSQL_PORT=3306
MYSQL_DATABASE=how-blog
MYSQL_USERNAME=
MYSQL_PASSWORD=
JPA_SHOW_SQL=false

# Article and user services. An empty password is valid for unauthenticated Redis.
REDIS_HOST=192.168.20.5
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# User and SMS services. Supply an existing RabbitMQ account and virtual host.
RABBITMQ_HOST=192.168.20.5
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=
RABBITMQ_VIRTUAL_HOST=/

# Search service uses the existing Elasticsearch transport protocol on port 9300.
ELASTICSEARCH_CLUSTER_NAME=elasticsearch
ELASTICSEARCH_CLUSTER_NODES=192.168.20.5:9300

# Article, user and gateway services must share one secret.
# Generate 32 cryptographically random bytes, then encode them as Base64.
# This is separate from the Nacos server's NACOS_AUTH_TOKEN.
JWT_SECRET=
JWT_TTL=360000

# SMS service only. Fill in real Aliyun configuration before starting that service.
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
