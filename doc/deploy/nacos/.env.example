# Copy to .env on the machine running Docker. Do not commit the real .env.
# If MySQL runs on the same NAS, use its published port on that NAS.
# For MySQL elsewhere, set MYSQL_HOST to its reachable IP or hostname.
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_USER=
# Single-quote a password containing a dollar sign, e.g. MYSQL_PASSWORD='...'.
MYSQL_PASSWORD=

# Use a unique Base64 secret whose decoded value is at least 32 characters.
# Generate one with: openssl rand -base64 48
NACOS_AUTH_TOKEN=
# Choose a custom HTTP header name, such as X-How-Blog-Nacos-Identity.
NACOS_AUTH_IDENTITY_KEY=
# Generate a separate value with: openssl rand -hex 32
NACOS_AUTH_IDENTITY_VALUE=
